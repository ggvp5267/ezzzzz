## Команды диагностики (для отчёта и для вопросов преподавателя)

```bash
############ 1. Система и сеть ############
hostnamectl                                  # имя ВМ (ggServer)
ip -br a                                     # IP 192.168.25.250/24
ip r                                         # default via 192.168.25.252
cat /etc/netplan/99-lan-interface.yaml       # конфиг интерфейса
ping -c2 192.168.25.252; ping -c2 8.8.8.8; ping -c2 ubuntu.com
id gg                                        # пользователь есть, группа sudo

############ 2. Сервисы активны / включены в автозагрузку ############
PHPV=$(php -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;')
systemctl status nginx mysql php${PHPV}-fpm --no-pager
systemctl is-active nginx mysql php${PHPV}-fpm
systemctl is-enabled nginx mysql php${PHPV}-fpm
systemctl status apache2 --no-pager          # должен быть inactive/dead

############ 3. Процессы Nginx (рис. 2.2 и 2.3 методички) ############
ps -efH | grep nginx                         # master от root, worker от www-data
sudo ss -tlpn                                # слушаются 80, 443, 3306, 22
sudo ss -4lpn | grep 443
grep -E '^user|worker_processes' /etc/nginx/nginx.conf
nproc                                        # число ядер (≈ число воркеров)
cat /run/nginx.pid                           # PID master-процесса
nginx -s reload                              # = SIGHUP мастеру: перечитать конфиг без потери соединений

############ 4. Конфигурация Nginx ############
nginx -v
nginx -t                                     # syntax is ok / test is successful
ls -l /etc/nginx/sites-enabled/              # симлинк на sites-available/default
cat /etc/nginx/sites-available/default
cat /etc/nginx/snippets/self-signed.conf
cat /etc/nginx/snippets/ssl-params.conf
nginx -T | grep -E 'ssl_protocols|http2|ssl_certificate'

############ 5. MySQL ############
mysql -uroot -pubuntu -e "SHOW DATABASES; SELECT user,host,plugin,authentication_string FROM mysql.user;"
mysql -ugg -pgg -e "SHOW DATABASES; USE wordpress; SHOW TABLES;"
mysql -uroot -pubuntu -e "SHOW GRANTS FOR 'gg'@'localhost';"

############ 6. PHP и WordPress ############
php -v
php -m | grep -Ei 'mysql|gd|zip'
ls -l /run/php/                              # сокет php-fpm
ls /var/www/html                             # файлы WordPress
stat -c '%U:%G %n' /var/www/html            # www-data:www-data
curl -I http://localhost                     # 301/302 на https (после SSL)
curl -skI https://localhost | head -5        # 200 OK

############ 7. Где лежит сертификат и ключ ############
ls -l /etc/ssl/certs/nginx-selfsigned.crt    # сертификат (публичный)
ls -l /etc/ssl/private/nginx-selfsigned.key  # закрытый ключ (права 600, root)
ls -l /etc/nginx/dhparam.pem                 # параметры Диффи-Хеллмана (PFS)

############ 8. Содержимое и срок сертификата ############
openssl x509 -in /etc/ssl/certs/nginx-selfsigned.crt -noout -subject -issuer -dates -fingerprint -sha256
openssl x509 -in /etc/ssl/certs/nginx-selfsigned.crt -noout -ext subjectAltName
openssl x509 -in /etc/ssl/certs/nginx-selfsigned.crt -noout -text | grep -E 'Public-Key|Signature Algorithm'   # RSA 2048
openssl rsa -in /etc/ssl/private/nginx-selfsigned.key -check -noout                                           # RSA key ok
# ключ и сертификат — пара (хэши должны совпасть):
openssl x509 -noout -modulus -in /etc/ssl/certs/nginx-selfsigned.crt | md5sum
openssl rsa  -noout -modulus -in /etc/ssl/private/nginx-selfsigned.key | md5sum

############ 9. TLS 1.3 и HTTP/2 ############
curl -vkI --http2 https://localhost 2>&1 | grep -Ei 'TLSv1.3|ALPN|HTTP/2|subject|expire'
openssl s_client -connect localhost:443 -servername gg.bsuir.lab -tls1_3 </dev/null 2>/dev/null | grep -E 'Protocol|Cipher|subject|issuer'
openssl s_client -connect localhost:443 -tls1_2 </dev/null 2>&1 | head -5   # должен быть отказ (handshake failure)

############ 10. Логи и файрвол ############
tail -n 20 /var/log/nginx/access.log
tail -n 20 /var/log/nginx/error.log
journalctl -u nginx -n 30 --no-pager
ufw status; iptables -S                      # на всякий случай: не блокирует ли 80/443
```

