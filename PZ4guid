## Скрипт 2: связка Prometheus ↔ Alertmanager + правило HttpFlood

```bash
cat > /root/pz4_stage2.sh <<'EOF_S2'
#!/bin/bash
set -e

echo "=== [1/3] prometheus.yml: добавляем alerting и rule_files ==="
cat > /etc/prometheus/prometheus.yml <<'EOF'
global:
  scrape_interval: 1s
  evaluation_interval: 1s
  scrape_timeout: 1s
  external_labels:
    monitor: 'gg-project'
alerting:
  alertmanagers:
    - static_configs:
        - targets: ['localhost:9093']
rule_files:
  - alert.rules.yml

scrape_configs:
  - job_name: "nginx"
    static_configs:
      - targets: ["127.0.0.1:9114"]
    metrics_path: "/metrics"
    scrape_interval: 1s
EOF
chown prometheus:prometheus /etc/prometheus/prometheus.yml

echo "=== [2/3] alert.rules.yml: правило HttpFlood ==="
cat > /etc/prometheus/alert.rules.yml <<'EOF'
groups:
- name: flood
  rules:
  - alert: HttpFlood
    expr: increase(nginx_http_requests_total[10s]) > 200
    labels:
      severity: critical
    annotations:
      summary: "High HTTP request rate detected"
EOF
chown prometheus:prometheus /etc/prometheus/alert.rules.yml

echo "=== [3/3] Проверка и перезапуск ==="
/usr/local/bin/promtool check config /etc/prometheus/prometheus.yml
/usr/local/bin/promtool check rules /etc/prometheus/alert.rules.yml
systemctl restart prometheus
sleep 2
systemctl status prometheus --no-pager | head -n 10
curl -s http://127.0.0.1:9090/-/healthy
echo
echo "Готово. Проверьте http://127.0.0.25:9090/alerts - правило HttpFlood должно быть Inactive."
EOF_S2
bash /root/pz4_stage2.sh
```

